{
  "name": "infiplus-ai-whatsapp-calling-agent",
  "version": "1.0.0",
  "description": "Production-ready WhatsApp AI Voice Calling Agent powered by Official WhatsApp Business Calling API, Sarvam AI, Gemini 2.5 Flash, and Supabase",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "whatsapp",
    "whatsapp-calling-api",
    "ai-receptionist",
    "webrtc",
    "sarvam-ai",
    "gemini",
    "supabase",
    "express",
    "typescript"
  ],
  "author": "Infiplus AI Team",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.48.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "opusscript": "^0.1.1",
    "werift": "^0.24.1",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
